<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- The platform-neutral tests of the Windows suite, run against the code the Linux app compiles. -->
  <ItemGroup Label="Shared tests">
    <Compile Include="..\ContextSnap.Tests\SharedSpecTests.cs;..\ContextSnap.Tests\MarkdownTests.cs;..\ContextSnap.Tests\RedactorTests.cs;..\ContextSnap.Tests\GitTests.cs;..\ContextSnap.Tests\GitFactAttribute.cs" LinkBase="Shared" />
    <None Include="..\..\spec\*.json" Link="spec\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ContextSnap.Linux\ContextSnap.Linux.csproj" />
  </ItemGroup>

</Project>

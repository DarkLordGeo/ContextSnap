<Window x:Class="ContextSnap.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapctx notification"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">

    <!-- The 12 DIP margin leaves room for the soft shadow inside the transparent window. -->
    <Grid x:Name="Root" Margin="12" Cursor="Hand" ToolTip="Click to dismiss">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <!-- Layered translucent borders give a soft shadow without a blur effect. -->
        <Border x:Name="ShadowOuter" CornerRadius="16" Margin="-6,-3,-6,-9" />
        <Border x:Name="ShadowMiddle" CornerRadius="14" Margin="-3,-1,-3,-5" />
        <Border x:Name="ShadowInner" CornerRadius="13" Margin="-1,0,-1,-2" />

        <Border x:Name="Card" CornerRadius="12" BorderThickness="1" SnapsToDevicePixels="True">
            <Grid x:Name="CardContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>

                <Grid x:Name="Body" Margin="16,14,18,14" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="BodyScale" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="IconHost" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="IconScale" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="IconDisc" />
                        <!-- Total stroke length is about 19 DIP = 7.4 dash units at thickness 2.6. -->
                        <Path x:Name="CheckMark" Data="M 9.5,16.5 L 14,21 L 22.5,11.5"
                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" StrokeDashArray="8 8" StrokeDashOffset="0" />
                        <Path x:Name="CrossMark" Data="M 11.5,11.5 L 20.5,20.5 M 20.5,11.5 L 11.5,20.5"
                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="CrossScale" />
                            </Path.RenderTransform>
                        </Path>
                        <Path x:Name="AlertMark" Data="M 16,9.5 L 16,17.5 M 16,22 L 16,22.2"
                              StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="MessageText" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <WrapPanel x:Name="StatsPanel" Margin="0,4,0,0" />
                        <Border x:Name="WarningRow" CornerRadius="6" Padding="8,5" Margin="0,9,0,0">
                            <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="ProgressTrack" Grid.Row="1" />
                <Border x:Name="ProgressBar" Grid.Row="1" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
